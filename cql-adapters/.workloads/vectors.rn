//! Vector CQL data type integration test workload.
//!
//! Tests the vector<float, N> type for AI/ML embeddings use cases.
//!
//! USAGE:
//!   latte schema --driver /tmp/driver.sock cql-adapters/workloads/vectors.rn
//!   latte load --driver /tmp/driver.sock -P row_count=1000 cql-adapters/workloads/vectors.rn
//!   latte run --driver /tmp/driver.sock -d 10s -r 100 -P row_count=1000 -f validate cql-adapters/workloads/vectors.rn

use latte::*;

// ============================================================================
// Configuration
// ============================================================================

const KEYSPACE = latte::param!("keyspace", "latte_vectors");
const TABLE = latte::param!("table", "vectors");
const ROW_COUNT = latte::param!("row_count", 10000);
const REPLICATION_FACTOR = latte::param!("replication_factor", 1);

// Vector dimensions - test various sizes
const VECTOR_DIM_SMALL = latte::param!("vector_dim_small", 3);
const VECTOR_DIM_MEDIUM = latte::param!("vector_dim_medium", 128);
const VECTOR_DIM_LARGE = latte::param!("vector_dim_large", 512);

const INSERT = "insert";
const SELECT_BY_PK_CK = "select_by_pk_ck";

// ============================================================================
// Schema
// ============================================================================

pub async fn schema(ctx) {
    ctx.execute(`
        CREATE KEYSPACE IF NOT EXISTS ${KEYSPACE}
        WITH replication = {
            'class': 'SimpleStrategy',
            'replication_factor': ${REPLICATION_FACTOR}
        }
    `).await?;

    ctx.execute(`DROP TABLE IF EXISTS ${KEYSPACE}.${TABLE}`).await?;

    ctx.execute(`
        CREATE TABLE ${KEYSPACE}.${TABLE} (
            pk bigint,
            ck bigint,

            -- Small vector (3D - for simple geometric use cases)
            col_vector_small vector<float, ${VECTOR_DIM_SMALL}>,

            -- Medium vector (128D - typical for face embeddings)
            col_vector_medium vector<float, ${VECTOR_DIM_MEDIUM}>,

            -- Large vector (512D - typical for text embeddings)
            col_vector_large vector<float, ${VECTOR_DIM_LARGE}>,

            -- Vector in a frozen list
            col_list_vectors frozen<list<vector<float, ${VECTOR_DIM_SMALL}>>>,

            -- Metadata alongside vectors
            col_label text,
            col_confidence float,

            PRIMARY KEY (pk, ck)
        )
    `).await?;
}

pub async fn erase(ctx) {
    ctx.execute(`TRUNCATE TABLE ${KEYSPACE}.${TABLE}`).await?
}

// ============================================================================
// Prepare
// ============================================================================

pub async fn prepare(ctx) {
    ctx.load_cycle_count = ROW_COUNT;

    ctx.prepare(INSERT, `
        INSERT INTO ${KEYSPACE}.${TABLE} (
            pk, ck,
            col_vector_small, col_vector_medium, col_vector_large,
            col_list_vectors,
            col_label, col_confidence
        ) VALUES (
            :pk, :ck,
            :col_vector_small, :col_vector_medium, :col_vector_large,
            :col_list_vectors,
            :col_label, :col_confidence
        )
    `).await?;

    ctx.prepare(SELECT_BY_PK_CK, `
        SELECT * FROM ${KEYSPACE}.${TABLE} WHERE pk = :pk AND ck = :ck
    `).await?;
}

// ============================================================================
// Data Generation
// ============================================================================

fn generate_vector(seed, dim) {
    let v = [];
    for j in 0..dim {
        v.push(latte::normal_f32(seed * dim + j, 0.0, 1.0));
    }
    v
}

fn generate_row_data(i) {
    let idx = i % ROW_COUNT;
    let pk = latte::hash(idx / 10);
    let ck = latte::hash(idx);

    // Small vector - always present
    let col_vector_small = generate_vector(idx, VECTOR_DIM_SMALL);

    // Medium vector - sometimes null
    let col_vector_medium = if idx % 10 == 0 { None } else {
        generate_vector(idx + 1000, VECTOR_DIM_MEDIUM)
    };

    // Large vector - sometimes null
    let col_vector_large = if idx % 15 == 0 { None } else {
        generate_vector(idx + 2000, VECTOR_DIM_LARGE)
    };

    // List of small vectors
    let col_list_vectors = if idx % 20 == 0 { None } else {
        [
            generate_vector(idx + 3000, VECTOR_DIM_SMALL),
            generate_vector(idx + 3001, VECTOR_DIM_SMALL),
            generate_vector(idx + 3002, VECTOR_DIM_SMALL),
        ]
    };

    // Metadata
    let col_label = if idx % 5 == 0 { None } else {
        let labels = ["cat", "dog", "bird", "fish", "horse", "cow", "sheep", "pig"];
        labels[idx % labels.len()]
    };
    let col_confidence = if idx % 7 == 0 { None } else {
        latte::normal_f32(idx + 4000, 0.8, 0.1)
    };

    #{
        "pk": pk,
        "ck": ck,
        "col_vector_small": col_vector_small,
        "col_vector_medium": col_vector_medium,
        "col_vector_large": col_vector_large,
        "col_list_vectors": col_list_vectors,
        "col_label": col_label,
        "col_confidence": col_confidence,
    }
}

// ============================================================================
// Load
// ============================================================================

pub async fn load(ctx, i) {
    let d = generate_row_data(i);

    ctx.execute_prepared(INSERT, [
        d.pk, d.ck,
        d.col_vector_small, d.col_vector_medium, d.col_vector_large,
        d.col_list_vectors,
        d.col_label, d.col_confidence,
    ]).await?
}

// ============================================================================
// Run
// ============================================================================

pub async fn run(ctx, i) {
    let d = generate_row_data(i);
    ctx.execute_prepared(SELECT_BY_PK_CK, [d.pk, d.ck]).await?
}

pub async fn validate(ctx, i) {
    let d = generate_row_data(i);
    let rows = ctx.execute_prepared_with_result(SELECT_BY_PK_CK, [d.pk, d.ck]).await?;

    if rows.len() != 1 {
        ctx.signal_failure(`Expected 1 row for pk=${d.pk}, ck=${d.ck}, got ${rows.len()}`).await?;
        return Ok(());
    }

    let row = rows.0;

    // Validate keys
    if row.get("pk")? != d.pk {
        ctx.signal_failure("pk mismatch").await?;
    }
    if row.get("ck")? != d.ck {
        ctx.signal_failure("ck mismatch").await?;
    }

    // Validate vectors
    validate_vector(ctx, row, d, "col_vector_small").await?;
    validate_vector(ctx, row, d, "col_vector_medium").await?;
    validate_vector(ctx, row, d, "col_vector_large").await?;

    // Validate list of vectors
    validate_column(ctx, row, d, "col_list_vectors").await?;

    // Validate metadata
    validate_column(ctx, row, d, "col_label").await?;
    validate_column(ctx, row, d, "col_confidence").await?;

    Ok(())
}

async fn validate_vector(ctx, row, expected, col_name) {
    let actual = row.get(col_name)?;
    let exp = expected.get(col_name)?;

    if is_none(exp) {
        if !is_none(actual) {
            ctx.signal_failure(`${col_name}: expected None, got vector`).await?;
        }
        return Ok(());
    }

    if is_none(actual) {
        ctx.signal_failure(`${col_name}: expected vector, got None`).await?;
        return Ok(());
    }

    if actual.len() != exp.len() {
        ctx.signal_failure(`${col_name} length mismatch: expected ${exp.len()}, got ${actual.len()}`).await?;
        return Ok(());
    }

    // Compare vector elements with floating point tolerance
    for i in 0..exp.len() {
        let diff = actual[i] - exp[i];
        if diff < 0.0 { diff = -diff; }
        if diff > 0.0001 {
            ctx.signal_failure(`${col_name}[${i}] mismatch: expected ${exp[i]}, got ${actual[i]}`).await?;
            return Ok(());
        }
    }

    Ok(())
}

async fn validate_column(ctx, row, expected, col_name) {
    let actual = row.get(col_name)?;
    let exp = expected.get(col_name)?;

    if is_none(exp) {
        if !is_none(actual) {
            ctx.signal_failure(`${col_name}: expected None, got non-null value`).await?;
        }
    } else if is_none(actual) {
        ctx.signal_failure(`${col_name}: expected non-null value, got None`).await?;
    }
    // Note: Deep comparison of vectors is not supported in Rune (no == or != operator
    // for Vec types). We only validate null/non-null status. Full content validation
    // would require element-by-element comparison which Rune doesn't support.
    Ok(())
}

// ============================================================================
// Benchmark Functions
// ============================================================================

pub async fn write(ctx, i) {
    load(ctx, i).await
}

pub async fn read(ctx, i) {
    let d = generate_row_data(i);
    ctx.execute_prepared(SELECT_BY_PK_CK, [d.pk, d.ck]).await?
}
