// Basic DynamoDB workload example for Latte
//
// This workload demonstrates simple read/write operations against
// DynamoDB or ScyllaDB Alternator.
//
// Usage:
//   latte schema  --dynamodb --dynamodb-endpoint http://localhost:8000 workloads/dynamodb/basic.rn
//   latte load    --dynamodb --dynamodb-endpoint http://localhost:8000 workloads/dynamodb/basic.rn
//   latte run     --dynamodb --dynamodb-endpoint http://localhost:8000 workloads/dynamodb/basic.rn

const TABLE_NAME = "latte_basic_test";
const ITEM_COUNT = latte::param!("items", 10000);

pub async fn schema(ctx) {
    // Clean up existing table (ignore errors if doesn't exist)
    let _ = ctx.delete_table(TABLE_NAME).await;

    // Create table with hash key
    ctx.create_table(
        TABLE_NAME,
        [dynamodb::dynamo_key_schema("pk", "HASH")],
        [dynamodb::dynamo_attribute_def("pk", "S")],
        Some(dynamodb::dynamo_throughput(100, 100)),
    ).await?;

    ctx.wait_table_active(TABLE_NAME).await?;
    Ok(())
}

pub async fn prepare(ctx) {
    ctx.load_cycle_count = ITEM_COUNT;
    Ok(())
}

pub async fn erase(ctx) {
    schema(ctx).await?;
    Ok(())
}

pub async fn load(ctx, i) {
    let pk = format!("item_{:012}", i);

    let item = #{
        "pk": dynamodb::dynamo_s(pk),
        "value": dynamodb::dynamo_n(i),
        "data": dynamodb::dynamo_s(format!("Data for item {}", i)),
        "active": dynamodb::dynamo_bool(i % 2 == 0),
    };

    ctx.put_item(TABLE_NAME, item, None).await?;
    Ok(())
}

pub async fn run(ctx, i) {
    // 80% reads, 20% writes (typical OLTP pattern)
    let operation = latte::hash_range(i, 100);
    let item_id = latte::hash_range(i, ITEM_COUNT);
    let pk = format!("item_{:012}", item_id);

    if operation < 80 {
        // Read operation
        let key = #{ "pk": dynamodb::dynamo_s(pk) };
        let result = ctx.get_item(TABLE_NAME, key, None).await?;
    } else {
        // Write operation - update an existing item
        let key = #{ "pk": dynamodb::dynamo_s(pk) };
        ctx.update_item(
            TABLE_NAME,
            key,
            Some(#{
                "update_expression": "SET #val = :newval",
                "expression_attribute_names": #{ "#val": "value" },
                "expression_attribute_values": #{
                    ":newval": dynamodb::dynamo_n(i),
                },
            }),
        ).await?;
    }

    Ok(())
}
